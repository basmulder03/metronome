{
  "name": "metronome",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "svelte-check && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "svelte-check",
    "e2e": "playwright test",
    "server:setup": "bash server/setup.sh",
    "server": "server/bin/pocketbase serve --http=127.0.0.1:8090 --dir=server/pb_data --migrationsDir=server/pb_migrations",
    "start": "npm run build && server/bin/pocketbase serve --http=0.0.0.0:8090 --publicDir=dist --dir=server/pb_data --migrationsDir=server/pb_migrations"
  },
  "dependencies": {
    "pdfjs-dist": "^6.4.299",
    "pocketbase": "^0.28.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.5",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.4"
  }
}
